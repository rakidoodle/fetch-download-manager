      "html": "<button class=\"ds-sample ds-primary\">New download</button>",
      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 20px;border:0;border-radius:10px;font-size:14px;font-weight:600;background:var(--action,#80b9ff);color:var(--action-ink,#101e30);cursor:pointer;transition:color 180ms,background-color 180ms,opacity 180ms,transform 120ms cubic-bezier(.16,1,.3,1);}.ds-primary:hover:not(:disabled){filter:brightness(1.08)}.ds-primary:active:not(:disabled){transform:scale(.98)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--action,#80b9ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-sample,.ds-sample *{transition:none!important;animation:none!important;transform:none!important}}"
