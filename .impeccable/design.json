  "narrative": {
    "northStar": "The Precise Local Workspace",
    "overview": "Fetch uses the user's chosen Apple website craft: graphite surfaces, silver type, a native sans, generous separation between tasks, and softly rounded controls. Dark mode is the default; the light theme preserves the same hierarchy through a complete paired palette. Apple is a craft reference, with Fetch's own identity and no affiliation claim.\n\nThe visual hierarchy gives adding and controlling downloads priority. Tonal layers distinguish the working library, fields, and sheets; color describes actions, source families, and real transfer states. Motion responds briefly to input and is disabled under reduced motion. The user-pinned native-font choice is scoped to this Apple-inspired Operate redesign.",
    "keyCharacteristics": [
      "Graphite and silver foundations with an action-blue accent.",
      "One native sans family, with a large display and compact operational metadata.",
      "Tonal surfaces, restrained dividers, and rounded controls.",
      "Input-driven artwork and brief, optional motion.",
      "Original Fetch SVG identity and locally served generated sculpture."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Use action blue for actionable controls and focus. Reserve mint, amber, coral, pink, and lavender for their observed status or source roles; preserve those roles in both themes.",
        "section": "colors"
      },
      {
        "name": "The Native Craft Rule",
        "body": "Retain the user's chosen native sans stack for this Apple-inspired Operate system. Use size, weight, and tracking to establish hierarchy within that single family.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Keep working surfaces free of decorative elevation. Apply the shared diffuse shadow to floating sheets and notifications.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the paired dark and light semantic colors rather than applying dark literals to themeable controls.",
      "Do keep keyboard focus visible and present a text label with status colors.",
      "Do give mobile job actions and detail actions the observed 44px targets.",
      "Do use the authored Fetch mark and locally served sculpture, preserving their existing identity and provenance.",
      "Do preserve independent YouTube resolution and format controls and the disabled resolution state for audio.",
      "Do keep motion responsive to input and honor reduced motion."
    ],
    "donts": [
      "Don't substitute Apple's logo or imply an Apple affiliation.",
      "Don't invent download activity, transfer totals, or speed claims to fill empty space.",
      "Don't add continuous decorative animation to the sculpture.",
      "Don't replace labeled controls with glyph characters or icon-font substitutes.",
      "Don't promote a page-specific hero composition into a rule for every future screen."
    ]
  }
}
