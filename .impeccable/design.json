      "css": ".ds-segmented{display:flex;padding:4px;gap:4px;border-radius:10px;background:var(--surface-inset,#151619)}.ds-segment{font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;flex:1;min-height:39px;padding:9px 10px;border:0;border-radius:7px;font-size:12px;color:var(--secondary,#acadb5);background:none;cursor:pointer;transition:color 180ms,background-color 180ms,opacity 180ms,transform 120ms cubic-bezier(.16,1,.3,1);}.ds-segment.ds-selected{background:var(--surface-raised,#25262b);color:var(--text,#f5f5f7)}.ds-segment:hover{color:var(--text,#f5f5f7)}.ds-segment:active:not(:disabled){transform:scale(.98)}.ds-segment:disabled{opacity:.5;cursor:not-allowed}.ds-segment:focus-visible{outline:2px solid var(--action,#80b9ff);outline-offset:4px}@media(max-width:600px){.ds-segment{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-sample,.ds-sample *{transition:none!important;animation:none!important;transform:none!important}}"
